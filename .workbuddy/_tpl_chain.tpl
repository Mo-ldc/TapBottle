eval:(function(){var T='cc.UITransform';var cv=cc.director.getScene().getChildByName('Canvas');var out=[];function info(n){var u=n.getComponent(T);var w=n.getWorldPosition();var g=n.getComponent('cc.Widget');return n.name+' p='+Math.round(n.position.x*10)/10+','+Math.round(n.position.y*10)/10+' w='+Math.round(w.x*10)/10+','+Math.round(w.y*10)/10+' s='+(u?Math.round(u.width)+'x'+Math.round(u.height):'-')+' a='+(u?u.anchorX+','+u.anchorY:'-')+' wg='+(g?g.bottom+(g.isAlignBottom?'B':'')+(g.isAlignTop?'T':'')+(g.isAlignLeft?'L':'')+(g.isAlignRight?'R':''):'-');}out.push('Canvas '+info(cv));var gr=cv.getChildByName('GameRoot');out.push('GameRoot '+info(gr));var bl=gr.getChildByName('bootLayer');out.push('bootLayer '+info(bl));var ctl=bl.getChildByName('BootCtl');out.push('BootCtl '+info(ctl));var lr=ctl.getChildByName('LoadingRoot');out.push('LoadingRoot '+info(lr));var bar=lr.getChildByName('Bar');out.push('Bar '+info(bar));var inner=bar.getChildByName('Inner');out.push('Inner '+info(inner));var tl=ctl.getChildByName('TitleRoot');out.push('TitleRoot '+info(tl));return out.join(' | ');})()
